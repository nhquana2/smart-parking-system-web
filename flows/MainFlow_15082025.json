    {
        "id": "dc4bbf1390bc1b63",
        "type": "function",
        "z": "681afbe6dc7caf82",
        "name": "Get doc ID for update",
        "func": "const response = {payload: {}}\n\nif (Object.keys(msg.payload).length === 0) {\n    node.error(\"Vehicle with RFID not found\", msg);\n    return null;\n}\n\nresponse.docID = Object.keys(msg.payload)[0]; //get document ID of 'vehicles'\nresponse.payload.timeOut = new Date();\nresponse.payload.status = \"exit\";\n\n// Price calculations\nconst pricePerHour = flow.get('pricePerHour') || 0;\nconst multiplier = flow.get('multiplier') || 1;\nconst maximumPrice = flow.get('maximumPrice') || Infinity; // Use Infinity if no max price is set\nconst additionalCharge = flow.get('additionalCharge') || 0;\n\nconst timeIn = new Date(msg.payload[Object.keys(msg.payload)[0]].timeIn.toDate());\nconst timeOut = response.payload.timeOut; \n\nconst durationInMillis = timeOut.getTime() - timeIn.getTime();\nconst hoursParked = Math.ceil(durationInMillis / 3600000); // 3600000 = 1000ms * 60s * 60min\n\nlet calculatedPrice = hoursParked * pricePerHour * multiplier;\nlet finalPrice = Math.min(calculatedPrice, maximumPrice);\nfinalPrice += additionalCharge;\n\nresponse.payload.fee = parseInt(finalPrice, 10)\n\nresponse.uid = msg.rfidUID;\nresponse.licensePlate = msg.licensePlate;\nresponse.fee = response.payload.fee;\nresponse.timeOut = response.payload.timeOut;\n\nreturn response;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1520,
        "y": 1060,
        "wires": [
            [
                "72a396d7bc4c049b"
            ]
        ]
    },
