    {
        "id": "aff497b78a0e8348",
        "type": "function",
        "z": "681afbe6dc7caf82",
        "name": "Response msg",
        "func": "function isEmpty(val) {\n    return val == null ||\n           (typeof val === \"object\" && Object.keys(val).length === 0) ||\n           (typeof val === \"string\" && val.trim() === \"\");\n}\n\nconst { rfid, vehicle } = msg.payload;\n\nconst response = { payload: {} };\n\n//Invalid RFID card\nif (isEmpty(rfid)) {\n    response.payload.message = \"ERROR-INVALID-RFID\";\n    return response;\n}\n\n// No vehicle, RFID free\nif (isEmpty(vehicle)) {\n    response.payload.message = \"SUCCESS\";\n    response.payload.type = \"IN\";\n    response.payload.uid = Object.values(rfid)[0].uid;\n    return response;\n}\n\n// Vehicle is parking\nresponse.payload.message = \"SUCCESS\";\nresponse.payload.type = \"OUT\";\nresponse.payload.uid = Object.values(rfid)[0].uid;\nresponse.payload.licensePlate = Object.values(vehicle)[0].licensePlate;\nreturn response;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
